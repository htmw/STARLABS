remove the .example suffix from the filename and fill in the values as needed.

# ── Backend ───────────────────────────────────────────────────────────────────
# Local dev (Docker Compose mongo service):
MONGODB_URI= add_your_mongodb_connection_string_here  # add the original connection string

JWT_SECRET=dev-secret-change-me

PORT=4000

# URL the backend uses to reach the ML service
ML_SERVICE_URL=http://ml-service:8000

# ── ML Service ────────────────────────────────────────────────────────────────
MODEL_PATH=/app/best_model_b4.pt

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# Leave empty when frontend nginx proxies /api/* to backend container.
# Set to http://localhost:4000 for local `npm run dev` without Docker.
VITE_BACKEND_URL= http://localhost:4000

GROQ_API_KEY={GROQ_API_KEY}
