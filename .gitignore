# time — but should never be committed to git (it is large).
# Share the file out-of-band (Google Drive, DVC, S3, etc.)
ml-service/*.hdf5
ml-service/*.h5

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
.vscode/
*.swp